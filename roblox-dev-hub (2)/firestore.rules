rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Assets collection
    match /assets/{assetId} {
      allow read, write: if true;
    }

    // Comments collection
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // Community / Forum posts
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}

