{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Roblox Dev Hub",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "uploads": { "type": "number" },
        "downloads": { "type": "number" },
        "likes": { "type": "number" },
        "followers": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["username"]
    },
    "Asset": {
      "title": "Asset",
      "description": "Roblox developer asset model, script, map, UI, or plugin",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "gameType": { "type": "string" },
        "style": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "fileURL": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "creator": { "type": "string" },
        "creatorId": { "type": "string" },
        "downloads": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "version": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "securityStatus": { "type": "string" },
        "hasSuspiciousScript": { "type": "boolean" },
        "suspiciousWarnings": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "category"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User reviews and comments on assets",
      "type": "object",
      "properties": {
        "assetID": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "message": { "type": "string" },
        "rating": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["assetID", "message"]
    }
  }
}
